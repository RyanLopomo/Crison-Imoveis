generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id           String   @id @default(cuid())
  title        String
  description  String
  price        Int
  type         String
  category     String
  city         String
  neighborhood String
  address      String?
  bedrooms     Int?
  bathrooms    Int?
  parkingSpots Int?
  area         Int?
  imageUrl     String
  status       String   @default("Disponível")
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([featured, status])
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  phone      String
  interest   String
  message    String?
  propertyId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Admin {
  id String @id @default(cuid())
  name String @default("Administrador")
  email String @unique
  passwordHash String
  emailVerified Boolean @default(false)
  recoveryPhone String?
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tokens AccountToken[]
  sessions AdminSession[]
}

model AdminSession {
  id String @id
  adminId String
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([adminId])
  @@index([expiresAt])
}

model AccountToken {
  id String @id @default(cuid())
  adminId String
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  purpose String
  newEmail String?
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([adminId, purpose])
  @@index([expiresAt])
}

model AuthRateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
